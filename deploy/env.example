# birdnet-snapshot settings. Mode 600: holds the storage zone password.
# Every flag has an env var; run `birdnet-snapshot run -h` for the full list.

BIRDNET_URL=http://127.0.0.1:8080
# TZ=America/Los_Angeles          # BirdNET-Go's zone; auto-detected if unset

# From `birdnet-snapshot bunny-setup` (the storage zone password, not the account API key)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_KEY=

# Privacy
# SKIP_AUDIO_SOURCES=doorbell,porch  # never publish clips from these sources
# SNAPSHOT_NO_AUDIO=true             # publish no clips at all

# Scope
# SNAPSHOT_DAYS=7
# SNAPSHOT_MAX_PAGES=150
# SNAPSHOT_MAX_CLIPS=1500
# SNAPSHOT_LABEL=Snapshot

# Monitoring: node_exporter textfile collector
# SNAPSHOT_METRICS_FILE=/var/lib/node_exporter/textfile/birdnet_snapshot.prom
