# birdnet-snapshot report (Field Notes) settings. Mode 600: holds the storage zone password.
# Use a separate storage zone from the snapshot; `birdnet-snapshot report -h` lists every flag.

BIRDNET_URL=http://127.0.0.1:8080
# TZ=America/Los_Angeles          # BirdNET-Go's zone; auto-detected if unset

REPORT_DEPLOY=true
# Report period in days (systemd keeps inline comments, so they go on their own line)
SNAPSHOT_DAYS=7
# REPORT_TITLE=Field Notes
# REPORT_SUBTITLE=A week of birdsong, as heard by the station
# REPORT_STATION=A backyard        # cover text; keep it vague
# REPORT_PDF=true
# REPORT_PHOTOS=true               # Avicommons photos; false = BirdNET-Go's images only

# A note on the cover saying what the station runs on, behind a button. The
# first line is the lead sentence, later "Label: value" lines are rows, and
# leaving REPORT_RIG unset leaves the button off. Nothing is read from the
# host, so keep hostnames and addresses out of it: SNAPSHOT_FORBID refuses the
# publish if one reaches the page. systemd keeps the quotes, not the newlines,
# so write it on one line with \n, or set it from a drop-in.
# REPORT_RIG_TITLE=Run at home
# REPORT_RIG=BirdNET-Go runs on one mini desktop at home.\nCPU: Intel Core i5-8600T, 6 cores, 35 W\nMemory: 32 GB DDR4

# Recordings: the 3 best and 3 latest clips. Same privacy rules as the snapshot.
SKIP_AUDIO_SOURCES=doorbell
# REPORT_CLIPS=3                   # 0 leaves the Listen section out
# REPORT_CLIP_MIN=0.5              # lowest confidence a published clip may have
# REPORT_DAWN=true                 # dawn-chorus onset panels; false leaves them out (see README, Privacy)
# REPORT_WEATHER=true               # weather chart from BirdNET-Go's hourly weather
# REPORT_SPECIES_CLIPS=2           # recordings per species for the species view; 0 = none
# Soundscape: BirdNET-Go's sound-level metrics in Prometheus (skipped when unset)
# REPORT_PROMETHEUS=https://prometheus.example.com
# REPORT_PROMETHEUS_USER=reader
# REPORT_PROMETHEUS_PASSWORD=...
# Weekly issues, feed and link previews. Keep the issues directory: it is the archive.
# REPORT_ISSUES=/home/you/.local/share/birdnet-report/issues
# REPORT_ISSUE_WEEKS=12            # at most this many finished weeks frozen per run
# REPORT_URL=https://fieldnotes.example.com   # enables feed.xml, link previews and the share image
# REPORT_SHARE=true
# NTFY_URL=https://ntfy.example.com/birds     # announce each new issue
# NTFY_TOKEN=
# SNAPSHOT_FORBID='home\.lan,192\.168\.[0-9]+\.[0-9]+'

# From `birdnet-snapshot bunny-setup -fallback /index.html` (the storage zone password, not the account API key)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_KEY=
