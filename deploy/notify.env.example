# Settings for `birdnet-snapshot audit` and `rare`. Mode 600 if the topic needs a token.
# Every flag has an env var; `birdnet-snapshot audit -h` and `rare -h` list them all.
# systemd drops unquoted backslashes, so single-quote any regex.

BIRDNET_URL=http://127.0.0.1:8080

NTFY_URL=https://ntfy.example.com/birds
# NTFY_TOKEN=tk_...
# BIRDNET_LINK=https://birdnet.example.com   # BirdNET-Go as your phone reaches it: where a tap goes

# audit
# AUDIT_HOURS=48                  # look back this far
# AUDIT_DOMINANT=0.25             # a species this large, with thin evidence, is flagged
# AUDIT_SOURCE_SHARE=0.7          # one microphone behind this share of a species
# AUDIT_NIGHT_HITS=3              # daytime birds heard at night
# AUDIT_IGNORE='Great Tit'        # species to leave out of every check
# AUDIT_NOCTURNAL='Dickcissel'    # extra species that may call at night
# AUDIT_RENOTIFY=168h             # repeat an unresolved finding after this long
# AUDIT_METRICS_FILE=/var/lib/node_exporter/textfile/birdnet_audit.prom

# rare
# RARE_WINDOW=90m                 # detections this close together are one visit
# RARE_MIN_HITS=2
# RARE_RARITY=0.5                 # range-model score under which a species is rare here
# RARE_GAP=24h                    # at most one alert per species per day
